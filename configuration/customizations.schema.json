{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JennyJoshua/niversal-software-customizer/blob/main/configuration/customizations.schema.json",
  "title": "USC Customization Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "customizations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "customizations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "purpose",
          "category",
          "protection_mode",
          "paths"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "branding",
              "feature_workflow",
              "business_rule",
              "configuration",
              "data_api_contract",
              "integration",
              "engineering_asset"
            ]
          },
          "protection_mode": {
            "enum": [
              "preserve",
              "require_regression_tests",
              "block_for_review"
            ]
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "ownership"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[*?\\[\\]\\\\]).+$"
                },
                "ownership": {
                  "enum": [
                    "custom_only",
                    "mixed"
                  ]
                }
              }
            }
          },
          "test_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            }
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          },
          "review_note": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "protection_mode": {
                  "const": "require_regression_tests"
                }
              },
              "required": [
                "protection_mode"
              ]
            },
            "then": {
              "required": [
                "test_ids"
              ],
              "properties": {
                "test_ids": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "protection_mode": {
                  "const": "block_for_review"
                }
              },
              "required": [
                "protection_mode"
              ]
            },
            "then": {
              "required": [
                "review_note"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "protection_mode": {
                  "const": "preserve"
                }
              },
              "required": [
                "protection_mode"
              ]
            },
            "then": {
              "properties": {
                "paths": {
                  "items": {
                    "properties": {
                      "ownership": {
                        "const": "custom_only"
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
